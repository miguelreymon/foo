# Backend .env - Copia como .env y rellena con tus valores reales
# NO subas el .env a GitHub

YOUTUBE_API_KEY=tu_youtube_api_key
GEMINI_API_KEY=tu_gemini_api_key_principal
GEMINI_API_KEY_BACKUP=tu_gemini_api_key_respaldo
RAPIDAPI_KEY=tu_rapidapi_key

# Firebase - Opción A: Variables individuales
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_PRIVATE_KEY_ID=tu_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=tu_client_id

# Firebase - Opción B: archivo JSON (para desarrollo local)
# Guarda el JSON de Firebase Console como firebase-credentials.json
# (ya está en .gitignore, no se subirá)

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu_password_seguro
